{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "mcp__plugin_agentic-harness_docs-langchain",
      "mcp__plugin_agentic-harness_reference-langchain",
      "mcp__plugin_agentic-harness_langfuse-docs",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)"
