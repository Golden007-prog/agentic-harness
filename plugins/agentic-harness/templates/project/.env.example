# Copia este archivo a .env y completa los valores. .env no se sube al repositorio.
# - La CLI, el servidor y la evaluación cargan .env al arrancar; las variables ya definidas en el
#   entorno (Docker, CI, gestor de secretos) tienen prioridad sobre este archivo.
# - Una variable vacía equivale a no definida: se usa el valor por defecto de config.py.
# - Comprueba la configuración sin arrancar el agente: uv run python -m agents.<nombre>.config

# Anthropic
ANTHROPIC_API_KEY=

# Modelo (config.py)
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-opus-5-5
AGENT_MAX_TOKENS=
AGENT_TIMEOUT_S=
AGENT_MAX_RETRIES=

# Límites del agente (guards.py): timeout del turno, llamadas por turno y presupuesto de tokens
AGENT_RUN_TIMEOUT_S=
AGENT_MAX_MODEL_CALLS=
AGENT_MAX_TOOL_CALLS=
# 0 = sin límite
AGENT_SESSION_TOKEN_BUDGET=

# Tools con efectos externos: true = modo prueba (simulan la acción). Pon false para actuar de verdad.
AGENT_DRY_RUN=true

# Histórico de conversación (memory.py): memory | sqlite | postgres
HISTORY_BACKEND=memory
# Ruta del archivo SQLite o cadena de conexión de Postgres
HISTORY_URL=
# trim | summarize
HISTORY_STRATEGY=trim
HISTORY_MAX_TOKENS=

# Entorno y versión (aparecen en las trazas). APP_ENV: dev | staging | prod
APP_ENV=dev
APP_RELEASE=

# Servidor HTTP: si se define, se exige "Authorization: Bearer <token>"
AGENT_API_TOKEN=
PORT=8000

# Langfuse (sin claves, las trazas se desactivan)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
